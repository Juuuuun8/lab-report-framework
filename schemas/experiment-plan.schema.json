{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EXPERIMENT_PLAN.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "objective", "independent_variables", "dependent_variables", "controlled_variables", "replications", "execution_order", "exclusion_rules", "stop_conditions", "analysis", "safety_reviewed"],
  "properties": {
    "status": {"enum": ["draft", "approved"]},
    "objective": {"type": "string", "minLength": 1},
    "independent_variables": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "dependent_variables": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "controlled_variables": {"type": "array", "items": {"type": "string"}},
    "replications": {"type": "integer", "minimum": 1},
    "warmups": {"type": "integer", "minimum": 0},
    "random_seed": {"type": ["integer", "null"]},
    "execution_order": {"type": "string", "minLength": 1},
    "exclusion_rules": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "analysis": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "safety_reviewed": {"type": "boolean"}
  }
}

