{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PROFESSOR_REVIEW.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["evaluator_role", "reviewed_at", "rubric", "overall", "limitations"],
  "properties": {
    "evaluator_role": {"const": "codex_simulated_professor"},
    "reviewed_at": {"type": "string", "minLength": 10},
    "rubric": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rubric_id", "score", "verdict", "evidence", "criticism", "improvement"],
        "properties": {
          "rubric_id": {"type": "string", "pattern": "^RUB-[0-9]{3}$"},
          "score": {"type": "integer", "minimum": 1, "maximum": 5},
          "verdict": {"enum": ["met", "partially_met", "not_met"]},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "criticism": {"type": "string", "minLength": 1},
          "improvement": {"type": "string", "minLength": 1}
        }
      }
    },
    "overall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score_percent", "verdict", "strengths", "weaknesses"],
      "properties": {
        "score_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "verdict": {"enum": ["ready", "revise"]},
        "strengths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "weaknesses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "limitations": {"type": "string", "minLength": 1}
  }
}
