{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PROFESSOR_REVIEW.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["evaluator_role", "reviewed_at", "reviewed_pdf_sha256", "reviewed_inputs_digest", "rubric", "overall", "limitations"],
  "properties": {
    "task_scope_reviews": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["task_id", "status", "evidence"],
        "properties": {
          "task_id": {"type": "string", "pattern": "^TASK-[0-9]{3}$"},
          "status": {"enum": ["passed", "failed", "pending"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "evaluator_role": {"const": "codex_simulated_professor"},
    "reviewed_at": {"type": "string", "minLength": 10},
    "reviewed_pdf_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reviewed_inputs_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rubric": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rubric_id", "score", "verdict", "report_locators", "evidence", "criticism", "improvement"],
        "properties": {
          "rubric_id": {"type": "string", "pattern": "^RUB-[0-9]{3}$"},
          "score": {"type": ["number", "null"], "minimum": 0},
          "verdict": {"enum": ["met", "partially_met", "not_met", "undetermined", "not_applicable"]},
          "report_locators": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "criticism": {"type": "string", "minLength": 1},
          "improvement": {"type": "string", "minLength": 1}
        }
      }
    },
    "overall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score_percent", "verdict", "strengths", "weaknesses"],
      "properties": {
        "score_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "verdict": {"enum": ["ready", "revise"]},
        "strengths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "weaknesses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "limitations": {"type": "string", "minLength": 1}
  }
}
