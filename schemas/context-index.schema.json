{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CONTEXT_INDEX.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["documents"],
  "properties": {
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "verified_summary", "related_gates", "reread_when"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "verified_summary": {"type": "string", "minLength": 1},
          "related_gates": {
            "type": "array",
            "minItems": 1,
            "items": {"enum": ["G1", "G2", "G3"]}
          },
          "reread_when": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
