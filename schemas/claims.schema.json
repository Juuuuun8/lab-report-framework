{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CLAIMS.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["claims"],
  "properties": {
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "kind", "text", "report_locator", "source_ids", "result_ids", "status"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^C-[0-9]{3}$"},
          "kind": {"enum": ["external", "result", "inference", "limitation", "method"]},
          "text": {"type": "string", "minLength": 1},
          "report_locator": {"type": "string", "minLength": 1},
          "source_ids": {"type": "array", "items": {"type": "string", "pattern": "^S-[0-9]{3}$"}},
          "result_ids": {"type": "array", "items": {"type": "string", "pattern": "^R-[0-9]{3}$"}},
          "status": {"enum": ["draft", "verified", "rejected"]},
          "verification_note": {"type": "string"}
        }
      }
    }
  }
}
