{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASSIGNMENT_REQUIREMENTS.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["assignment", "instruction_sources", "requirements", "rubric_criteria"],
  "properties": {
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["course", "title", "submission_format", "deadline"],
      "properties": {
        "course": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "submission_format": {"type": "string", "minLength": 1},
        "deadline": {"type": ["string", "null"]}
      }
    },
    "instruction_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instruction_id", "path", "read_complete", "locator_scope"],
        "properties": {
          "instruction_id": {"type": "string", "pattern": "^I-[0-9]{3}$"},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
          "read_complete": {"type": "boolean"},
          "locator_scope": {"type": "string", "minLength": 1},
          "note": {"type": ["string", "null"]}
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "category", "description", "source_locator", "mandatory", "verification_method"],
        "properties": {
          "requirement_id": {"type": "string", "pattern": "^REQ-[0-9]{3}$"},
          "category": {"enum": ["content", "format", "submission", "experiment", "prohibition"]},
          "description": {"type": "string", "minLength": 1},
          "source_locator": {"type": "string", "minLength": 1},
          "mandatory": {"type": "boolean"},
          "verification_method": {"type": "string", "minLength": 1}
        }
      }
    },
    "rubric_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rubric_id", "criterion", "source_locator", "required", "acceptance_criteria"],
        "properties": {
          "rubric_id": {"type": "string", "pattern": "^RUB-[0-9]{3}$"},
          "criterion": {"type": "string", "minLength": 1},
          "source_locator": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "weight": {"type": ["number", "null"], "minimum": 0},
          "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
