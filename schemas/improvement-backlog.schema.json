{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IMPROVEMENT_BACKLOG.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["improvement_id", "level", "problem", "evidence", "impact", "proposal", "status"],
        "properties": {
          "improvement_id": {"type": "string", "pattern": "^IMP-[0-9]{3}$"},
          "level": {"enum": ["L0", "L1", "L2"]},
          "problem": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "impact": {"type": "string", "minLength": 1},
          "proposal": {"type": "string", "minLength": 1},
          "status": {"enum": ["candidate", "approved", "implemented", "rejected"]},
          "user_decision": {"type": ["string", "null"]},
          "regression_test": {"type": ["string", "null"]},
          "token_effect": {"type": ["string", "null"]}
        }
      }
    }
  }
}
